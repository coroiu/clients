{
  "name": "bit-pam",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "bitwarden_license/bit-pam/src",
  "projectType": "library",
  "tags": ["scope:bitwarden-license"],
  "targets": {
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["bitwarden_license/bit-pam/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "bitwarden_license/bit-pam/jest.config.js"
      },
      "dependsOn": [
        {
          "projects": ["sdk-wasm"],
          "target": "build"
        },
        {
          "projects": ["sdk-wasm"],
          "target": "build-commercial"
        }
      ]
    }
  },
  "implicitDependencies": ["sdk-wasm"]
}
